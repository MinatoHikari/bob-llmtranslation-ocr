{
    "identifier": "com.saladict.bob.llm-translate",
    "version": "1.0.0",
    "category": "translate",
    "name": "DeepSeek / GLM 翻译",
    "summary": "使用 DeepSeek / 智谱 GLM（Z.ai / open.bigmodel.cn）的 OpenAI 兼容接口翻译，支持普通与 Coding Plan 端点、自定义模型",
    "author": "MinatoHikari",
    "homepage": "https://github.com/MinatoHikari/bob-llmtranslation-ocr",
    "minBobVersion": "0.5.0",
    "options": [
        {
            "identifier": "endpoint",
            "type": "menu",
            "title": "接口",
            "defaultValue": "deepseek",
            "menuValues": [
                {
                    "title": "DeepSeek 官方 (api.deepseek.com)",
                    "value": "deepseek"
                },
                {
                    "title": "Z.ai 国际站 · 按量付费",
                    "value": "zai"
                },
                {
                    "title": "Z.ai 国际站 · Coding Plan",
                    "value": "zai_coding"
                },
                {
                    "title": "智谱中国站 · 按量付费",
                    "value": "bigmodel"
                },
                {
                    "title": "智谱中国站 · Coding Plan",
                    "value": "bigmodel_coding"
                },
                {
                    "title": "自定义 (OpenAI 兼容)",
                    "value": "custom"
                }
            ]
        },
        {
            "identifier": "customEndpoint",
            "type": "text",
            "title": "自定义接口地址 (选填，填了优先)",
            "textConfig": {
                "type": "visible",
                "placeholderText": "如 http://127.0.0.1:8080/v1"
            }
        },
        {
            "identifier": "apiKey",
            "type": "text",
            "title": "API Key (本地服务可留空)",
            "textConfig": {
                "type": "secure"
            }
        },
        {
            "identifier": "model",
            "type": "text",
            "title": "模型 (选填，如 deepseek-chat / glm-4.7)"
        }
    ]
}